{
  "require": {
    "mongodb/mongodb": "^1.19",
    "php": ">=8.0",
    "ext-curl": "*",
    "ext-pdo": "*",
    "ext-gd": "*",
    "ext-pdo_pgsql": "*",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.1"
  },
  "autoload": {
    "classmap": ["clases/"]
  },
  "autoload-dev": {
    "classmap": ["tests/"]
  },
  "config": {
    "audit": {
      "abandoned": "ignore"
    }
  }
}